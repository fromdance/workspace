server {
    listen ${NGINX_PORT};
    server_name localhost;
    
    location / {
        root /usr/share/nginx/html;
        index index.html;
    }

    location /second {
        root /usr/share/nginx/html;
        index index.html
    }

    location ~\.(gif|jpg|png)$ {
        root /data/images;
    }
}